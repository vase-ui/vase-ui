          ],
          "suite": "hiddenInputSizeTests"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "sets checked and unchecked data attributes"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "does not forward `value` prop"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "allows `null` value"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "associates `id` with the native button when `nativeButton=true`"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "sets `aria-labelledby` from a sibling label associated with the hidden input"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "updates fallback `aria-labelledby` when the hidden input id changes"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "prefers `aria-label` over an associated label"
        },
        {
          "describe": [
            "<Radio.Root />"
          ],
          "title": "prefers a render element's `aria-label` over an associated label"
        },
        {
          "describe": [
            "<Radio.Root />",
            "prop: onClick"
          ],
          "title": "propagates a single click event to ancestors per user click (nativeButton=%s)"
        },
        {
          "describe": [
            "<Radio.Root />",
            "prop: onClick"
          ],
          "title": "does not propagate to ancestors when stopPropagation() is called (nativeButton=%s)"
        },
        {
          "describe": [
            "<Radio.Root />",
            "prop: onClick"
          ],
          "title": "does not propagate a click to ancestors when selecting with arrow keys"
        },
        {
          "describe": [
            "<Radio.Root />",
            "prop: disabled"
          ],
          "title": "uses aria-disabled instead of HTML disabled"
        },
        {
          "describe": [
            "<Radio.Root />",
            "prop: disabled"
          ],
          "title": "does not acquire the field focused state when focused programmatically"
        },
        {
          "describe": [
            "<Radio.Root />",
            "prop: disabled"
          ],
          "title": "keeps the tab stop on a checked radio that is disabled"
        },
        {
          "describe": [
            "<Radio.Root />",
            "prop: readOnly"
          ],
          "title": "acquires the field focused state on focus"
        }
      ]
    }
