      "rows": [
        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "suite": "popupConformanceTests"
        },
        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "suite": "dialogRootSharedTests"
