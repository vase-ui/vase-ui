        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "suite": "detachedTriggersConformanceTests"
        },
        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "title": "ARIA attributes"
        },
        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "title": "synchronizes trigger ARIA attributes when initially open with a handle"
        },
        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "title": "synchronizes detached trigger ARIA attributes when initially open with a handle"
        },
        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "title": "does not re-render inactive detached triggers when the popup opens and closes"
        },
        {
          "describe": [
            "<AlertDialog.Root />"
          ],
          "title": "renders a viewport"
        },
        {
          "describe": [
            "<AlertDialog.Root />",
            "prop: onOpenChange"
          ],
          "title": "does not close when the backdrop is clicked"
        },
        {
          "describe": [
            "<AlertDialog.Root />",
            "prop: onOpenChange"
          ],
          "title": "keeps the trigger data-popup-open attribute and handle.isOpen when a controlled close is vetoed"
        },
        {
          "describe": [
            "<AlertDialog.Root />",
            "handle-backed roots"
          ],
          "title": "rewires the trigger and keeps pointer dismissal disabled after the root remounts while open"
        },
        {
          "describe": [
            "<AlertDialog.Root />",
            "handle-backed roots"
          ],
          "title": "enforces alert dialog state for handle-backed roots"
        },
        {
          "describe": [
            "<AlertDialog.Root />",
            "modality"
          ],
          "title": "makes other interactive elements on the page inert when a modal dialog is open",
          "conditions": [
            "skipIf(isJSDOM)"
          ]
        }
      ]
    }
