{
  "name": "@vase-ui/monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --filter @vase-ui/vue build",
    "typecheck": "tsc --project tsconfig.json && pnpm --filter @vase-ui/vue typecheck",
    "check:package": "pnpm --filter @vase-ui/vue check:package",
    "test": "pnpm --filter @vase-ui/vue test",
    "test:node": "pnpm --filter @vase-ui/vue test:node",
    "test:browser": "pnpm --filter @vase-ui/vue test:browser",
    "test:chromium": "pnpm --filter @vase-ui/vue test:chromium",
    "test:firefox": "pnpm --filter @vase-ui/vue test:firefox",
    "test:webkit": "pnpm --filter @vase-ui/vue test:webkit",
    "test:vapor-parts": "pnpm --filter @vase-ui/vue test:vapor-parts",
    "test:vapor": "pnpm --filter @vase-ui/vue test:vapor",
    "test:nuxt": "pnpm --filter @vase-ui/nuxt-fixture test",
    "test:vite": "pnpm --filter @vase-ui/vite-fixture test",
    "test:lint-rules": "node --test eslint.config.test.js",
    "test:parity": "node --test \"scripts/parity/*.test.ts\"",
    "test:docs": "node --test \"scripts/docs/*.test.ts\" \"docs/.vitepress/*.test.ts\"",
    "test:thanks": "node --test scripts/thanks/render.test.ts",
    "test:release": "node --test \"scripts/release/*.test.ts\"",
    "test:ci": "node --test \"scripts/ci/*.test.ts\"",
    "test:size": "node --test \"scripts/size/*.test.ts\"",
    "test:repo": "node --test \"scripts/repo/*.test.ts\"",
    "thanks:render": "node scripts/thanks/render.ts",
    "docs:dev": "pnpm --filter @vase-ui/docs dev",
    "docs:build": "pnpm --filter @vase-ui/docs build",
    "docs:preview": "pnpm --filter @vase-ui/docs preview",
    "docs:typecheck": "pnpm --filter @vase-ui/docs typecheck && node scripts/docs/sampleCompile.ts",
    "docs:axe": "node scripts/docs/axeSite.ts",
    "docs:search-focus": "node scripts/docs/searchBoxFocus.ts",
    "docs:demos": "node scripts/docs/upstreamDemos.ts",
    "parity:extract": "node scripts/parity/extract.ts",
    "parity:check": "node scripts/parity/check.ts",
    "parity:track": "node scripts/parity/track.ts",
    "release:check-tag": "node scripts/release/checkTag.ts",
    "lint": "pnpm test:lint-rules && pnpm test:parity && pnpm test:docs && pnpm test:thanks && pnpm test:release && pnpm test:ci && pnpm test:size && pnpm test:repo && eslint . --max-warnings 0 && prettier --check .",
    "lint:fix": "eslint . --fix; prettier --write .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tsconfig/strictest": "2.0.9",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "marked": "18.2.0",
    "prettier": "3.9.10",
    "resolve-pkg-maps": "1.0.0",
    "tsdown": "0.23.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vue": "3.5.45",
    "vue-component-meta": "3.3.14",
    "vue-eslint-parser": "10.4.2"
  }
}
