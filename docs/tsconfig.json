{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitepress/client"]
  },
  "vueCompilerOptions": {
    "strictTemplates": true
  },
  "include": [
    ".vitepress/**/*.ts",
    ".vitepress/**/*.vue",
    "*.data.ts",
    "components/**/*.vue",
    "demos/**/*.vue",
    "examples/**/*.vue",
    "utils/**/*.vue"
  ],
  "exclude": [".vitepress/cache", ".vitepress/dist"]
}
